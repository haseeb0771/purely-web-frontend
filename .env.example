# Copy to .env for local development (never commit .env).

# ------------------------------ PRODUCTION (Vercel) ------------------------------
# REQUIRED on Vercel -> web-frontend -> Environment Variables:
#   NEXT_PUBLIC_API_URL = https://purely-backend.vercel.app   (NO trailing slash)
#   API_URL             = https://purely-backend.vercel.app   (server-side only)
NEXT_PUBLIC_API_URL=https://purely-backend.vercel.app
API_URL=https://purely-backend.vercel.app

# ------------------------------ DEVELOPMENT (this machine) ------------------------------
# Local backend runs on :5000. NEXT_PUBLIC_* is inlined into the browser bundle;
# API_URL is server-only.
# NEXT_PUBLIC_API_URL=http://localhost:5000
# API_URL=http://localhost:5000

# ------------------------------ Email (contact form) ------------------------------
# Used by src/app/api/contact/route.ts to send inquiry notifications.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password

# ------------------------------ Misc ------------------------------
# Reserved for future use; do not remove.
