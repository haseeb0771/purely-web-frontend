# ===========================================================================
# Web frontend (Purely admin + public site)  -  environment template
# ---------------------------------------------------------------------------
# COPY this file to `.env` (gitignored) and fill real values for local dev.
# In production the SAME keys are set directly on the host (e.g. Vercel
# project settings) - nothing here is a real secret and nothing concrete is
# ever committed.
#
# Keys this app actually reads:
#   - API_URL ........ used SERVER-SIDE only (Next.js API routes + admin
#                      server components). Browser requests resolve the API
#                      base from window.location.origin (same-origin behind
#                      the reverse proxy), so no NEXT_PUBLIC_* is required.
#                      Point this at the DEPLOYED backend in production.
#   - EMAIL_USER / EMAIL_PASS ... admin sign-in email footer / support
#                      notification transport (kept as placeholders below).
# ===========================================================================

# Deployed backend. Example = the deployed pure backend. In local dev use
# http://localhost:5000 (the backend runs on port 5000 on this machine).
API_URL=https://purely-backend.vercel.app

# Optional notification/support transport (placeholders - fill real values in
# a gitignored `.env`, or set as host env vars in production).
EMAIL_USER=
EMAIL_PASS=

# ---------------------------------------------------------------------------
# Legacy note: NEXT_PUBLIC_API_URL was removed from this repo - the admin
# panel uses the server-side API_URL above (same-origin in the browser) so no
# browser-bundled URL is shipped. If you deploy this frontend separately from
# the backend, set API_URL (server-side) here and provide the browser-facing
# origin via the reverse proxy so /api/* stays same-origin.
# ---------------------------------------------------------------------------
